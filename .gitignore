# Project metadata
.a0proj/

# Reference files (contains sensitive data)
_collect/
# Development tools (not needed for installation)
_tools/

# Python
__pycache__/
*.pyc
*.pyo
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Build artifacts
*.o
*.a
*.so
*.promptinclude.md
upgrade_bootstrap.sh
node_modules/

# Internal working notes / handovers (never publish - may contain infra/dev context)
# Patterns are deliberately prefix-independent: a handover named HANDOVER-x.md
# must be ignored just as surely as one named _HANDOVER-x.md. Requiring a
# leading underscore once let HANDOVER-20260914.md slip through untracked.
.notes/
*HANDOVER*
*Handover*
*handover*
_issues_review*.md
*issues_review*
github_comment_*.md

# Scratch / temporary working material: one-off helper and debug scripts,
# ad-hoc analysis notes, editor and tooling leftovers. Never published.
/tmp_*
/scratch_*
/debug_*
/analysis_*
/check_*
/fix_*
*.tmp
*.bak
*.orig
*.rej

# Screenshots. Local debug captures (mesh_*, radar_*, ...) stay private, but the
# six screenshots embedded in README.md are published product documentation and
# MUST stay tracked. A bare `screenshots/` rule cannot be overridden per file,
# because git never descends into an excluded directory - hence `screenshots/*`.
screenshots/*
!screenshots/status.png
!screenshots/channels.png
!screenshots/bridge-rules.png
!screenshots/spectrum.png
!screenshots/dedup.png
!screenshots/tracing.png

# Convention: any root-level path starting with an underscore is scratch or
# working material (analysis notes, one-off helpers, collected reference data)
# and is never published.
/_*
